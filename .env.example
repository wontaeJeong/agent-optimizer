# Export in your shell; the CLI does not auto-load this file.
AGENT_OPT_MODEL=openrouter/vendor/model:free
# Choose an available explicit :free model. live rejects other models; no paid fallback.
# OPENROUTER_API_KEY=
# The optional generic provider example uses MODEL_BASE_URL, MODEL_ID, MODEL_API_KEY.
# Provider credentials belong only in environment or your Harness credential store.
# Optional ACE upstream baseline:
# NVIDIA_API_KEY=
# ACE_RTL_LLM_SCRIPT=/absolute/path/to/custom_llm.py
